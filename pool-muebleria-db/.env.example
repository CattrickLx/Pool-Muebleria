# Copia este archivo como ".env" y cambia las contraseñas.
# El archivo .env NO se sube a GitHub (está en .gitignore).

POSTGRES_DB=pool_muebleria

# Administrador de la base: solo para crear tablas, respaldar y dar mantenimiento
POSTGRES_USER=pool_admin
POSTGRES_PASSWORD=cambia_esta_contrasena

# Contraseña del usuario "pool_app", con el que se conecta la página web
APP_DB_PASSWORD=cambia_esta_tambien

# Puerto en tu máquina (cámbialo si ya tienes otro PostgreSQL en el 5432)
DB_PORT=5432
